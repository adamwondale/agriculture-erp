# =============================================================================
# .env.example — Agriculture ERP Local Development
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# NOTE: POSTGRES_PORT is 5433 (not 5432) because Windows PostgreSQL 18 is
# running on 5432. To use 5432, stop the Windows service (requires admin):
#   sc stop postgresql-x64-18
# Then change POSTGRES_PORT to 5432.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USERNAME=agri_dev
RABBITMQ_PASSWORD=changeme_local_dev
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
